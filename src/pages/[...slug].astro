---
import { getCollection, type CollectionEntry } from "astro:content";
import Posts from "@layouts/Posts.astro";
import PostDetails from "@layouts/PostDetails.astro";
import getPageNumbers from "@utils/getPageNumbers";
import getPagination from "@utils/getPagination";
import getSortedPosts from "@utils/getSortedPosts";
import { getPosts } from "@utils/collection";
import { postPath } from "@utils/posts";

export async function getStaticPaths() {
  const posts = getSortedPosts(await getCollection("blog"));

  // Each post lives at /YYYY/MM/DD/slug/ and, for links from the old WordPress
  // export, at /YYYY-MM-DD-slug/ as well.
  const byDate = posts.map(post => ({
    params: { slug: postPath(post.id).slice(1, -1) },
    props: { post },
  }));
  const byFileName = posts.map(post => ({
    params: { slug: post.slug },
    props: { post },
  }));
  const pages = getPageNumbers(posts.length).map(n => ({
    params: { slug: `posts/${n}` },
    props: { page: n },
  }));

  return [...byDate, ...byFileName, ...pages];
}

interface Props {
  post?: CollectionEntry<"blog">;
  page?: number;
}

const { post, page } = Astro.props;
const all = await getPosts();
const pagination = post ? null : getPagination({ posts: all, page: page ?? 1 });
---

{post ? <PostDetails post={post} /> : <Posts {...pagination!} />}
