---
import Layout from "@layouts/Layout.astro";
import { SITE } from "@config";

const BITS = [
  ["red", "8%", "14%", "-30deg"],
  ["green", "78%", "10%", "40deg"],
  ["amber", "12%", "68%", "65deg"],
  ["blue", "74%", "64%", "-55deg"],
];
---

<Layout title={`Page not found | ${SITE.title}`}>
  <section class="nf dots" id="nf">
    <div class="bits" aria-hidden="true">
      {BITS.map(([c, l, t, r], i) => <i class="bit" style={`background:var(--${c});left:${l};top:${t};--r:${r};animation-delay:-${i * 1.3}s`} />)}
    </div>
    <div>
      <h1>4<span>0</span>4</h1>
      <p class="shrug" aria-hidden="true">¯\_(ツ)_/¯</p>
      <p class="sub muted" style="margin-inline:auto">This page fell apart. The diamond can be put back together, though.</p>
      <div class="cta" style="justify-content:center;margin-top:26px">
        <button class="btn btn--red" type="button" id="fix">Put it back together</button>
        <a class="btn" href="/posts/">Browse the archive</a>
      </div>
    </div>
  </section>
</Layout>

<script>
  import { burst } from "../scripts/fx";

  document.getElementById("fix")?.addEventListener("click", () => {
    const nf = document.getElementById("nf")!;
    const bits = [...nf.querySelectorAll<HTMLElement>(".bit")];
    const box = nf.getBoundingClientRect();
    nf.classList.add("fix");
    const w = bits[0].offsetWidth;
    const g = (w + 10) * 0.7071;
    const cx = box.width / 2;
    const cy = box.height / 2;
    // Red top, green right, amber left, blue bottom: the logo's layout.
    [[0, -1, 45], [1, 0, 135], [-1, 0, 315], [0, 1, 225]].forEach(([dx, dy, rot], i) => {
      bits[i].style.left = `${cx + dx * g - w / 2}px`;
      bits[i].style.top = `${cy + dy * g - w / 2}px`;
      bits[i].style.transform = `rotate(${rot}deg)`;
    });
    setTimeout(() => burst(box.left + cx, box.top + cy, 28), 850);
    setTimeout(() => (location.href = "/"), 1500);
  });
</script>
