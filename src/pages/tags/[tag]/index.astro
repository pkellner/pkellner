---
import TagPosts from "@layouts/TagPosts.astro";
import { getPosts, topicCounts } from "@utils/collection";
import { tagPageProps } from "@utils/tagPage";

export async function getStaticPaths() {
  const posts = await getPosts();
  return topicCounts(posts).map(t => ({ params: { tag: t.slug }, props: { name: t.name } }));
}

const { tag } = Astro.params;
const { name } = Astro.props;
const props = tagPageProps(await getPosts(), tag, name, 1, true);
---

<TagPosts {...props} />
