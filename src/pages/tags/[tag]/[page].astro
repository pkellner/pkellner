---
import TagPosts from "@layouts/TagPosts.astro";
import getPageNumbers from "@utils/getPageNumbers";
import { getPosts, postsWithTopic, topicCounts } from "@utils/collection";
import { tagPageProps } from "@utils/tagPage";

export async function getStaticPaths() {
  const posts = await getPosts();
  return topicCounts(posts).flatMap(t =>
    getPageNumbers(postsWithTopic(posts, t.slug).length).map(page => ({
      params: { tag: t.slug, page: String(page) },
      props: { name: t.name },
    }))
  );
}

const { tag, page } = Astro.params;
const { name } = Astro.props;
const props = tagPageProps(await getPosts(), tag, name, page);
---

<TagPosts {...props} />
