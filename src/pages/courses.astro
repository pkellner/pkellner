---
import Layout from "@layouts/Layout.astro";
import PageHead from "@components/PageHead.astro";
import { SITE } from "@config";
import { COURSES, PLURALSIGHT_PROFILE } from "../data/site";

const EXT = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17 17 7M8 7h9v9"/></svg>';
---

<Layout title={`Courses | ${SITE.title}`} activeNav="courses" description="Peter Kellner's Pluralsight courses on React, from the first component to Server Components.">
  <PageHead color="red" crumbs={[{ label: "courses" }]} title="Courses" sub="Nineteen courses on Pluralsight, including GraphQL, .NET and Ext JS. These five cover modern React, from the first component to Server Components." />
  <section class="band">
    <div class="wrap">
      <div class="grid3">
        {
          COURSES.map((c, i) => (
            <article class="card course rv" style="--r:0deg">
              <img src={c.image} alt="" width="640" height="400" loading="lazy" decoding="async" />
              <div class="course-b">
                <span class={`chip chip--${c.color}`} style="margin:0">Course {i + 1} of {COURSES.length}</span>
                <h2 class="course-t">{c.title}</h2>
                <p>{c.short}</p>
                <details>
                  <summary class="chip">Read more</summary>
                  <p style="margin-top:12px">{c.long}</p>
                </details>
                <a class={`btn btn--sm btn--${c.color}`} style="margin-top:auto;align-self:flex-start" href={c.url} rel="noopener">
                  Watch on Pluralsight <Fragment set:html={EXT} />
                </a>
              </div>
            </article>
          ))
        }
        <div class="card rv more-card">
          <div>
            <span class="chip chip--amber">+14 more</span>
            <h2 class="h2">GraphQL, .NET, Ext JS and more<span style="color:var(--amber)">.</span></h2>
            <p>The full catalog lives on my Pluralsight author page.</p>
          </div>
          <a class="btn btn--amber" href={PLURALSIGHT_PROFILE} rel="noopener">View all 19 courses <Fragment set:html={EXT} /></a>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  .course-t { font: 750 1.12rem/1.2 var(--display); font-stretch: 110%; letter-spacing: -0.03em; }
  details summary { cursor: pointer; list-style: none; align-self: flex-start; }
  .more-card { background: var(--band-ink); color: var(--on-ink); display: flex; flex-direction: column; justify-content: space-between; gap: 20px; }
  .more-card .h2 { margin-top: 18px; font-size: clamp(1.5rem, 3vw, 2.1rem); }
  .more-card p { margin-top: 12px; color: var(--on-ink-2); }
  .more-card .btn { align-self: flex-start; }
</style>
