---
import Layout from "@layouts/Layout.astro";
import PostCard from "@components/PostCard.astro";
import DiamondNav from "@components/DiamondNav.astro";
import YearChart from "@components/YearChart.astro";
import CourseCard from "@components/CourseCard.astro";
import Services from "@components/Services.astro";
import Credentials from "@components/Credentials.astro";
import Socials from "@components/Socials.astro";
import { getPosts, topicCounts } from "@utils/collection";
import { BRAND_COLORS, yearCounts } from "@utils/posts";
import { slugifyStr } from "@utils/slugify";
import { COURSES, RIBBON_TOPICS } from "../data/site";

const posts = await getPosts();
const [latest, ...rest] = posts;
const grid = rest.slice(0, 6);
const years = yearCounts(posts.map(p => p.entry));
const topics = topicCounts(posts);
const known = new Set(topics.map(t => t.slug));
const ribbon = RIBBON_TOPICS.filter(t => known.has(slugifyStr(t)));
const ARROW = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>';
---

<Layout>
  <section class="band hero dots">
    <i class="deco deco--1"></i><i class="deco deco--2"></i><i class="deco deco--3"></i><i class="deco deco--4"></i>
    <div class="wrap hero-in">
      <div class="hero-copy">
        <div class="chips">
          <span class="chip chip--amber">19 Pluralsight courses</span>
          <span class="chip">Microsoft MVP 2007–2018</span>
          <span class="chip chip--green">Code Camp founder</span>
        </div>
        <h1 class="h1">Building <em>better software</em> through <u>code</u> &amp; community<span class="red-dot">.</span></h1>
        <p class="lede">
          Full-stack architect sharing what <b>four decades</b> of shipping production code, teaching developers and running <b>Silicon Valley Code Camp</b> have taught me.
        </p>
        <div class="cta">
          <a class="btn btn--blue" href="/posts/">Read the blog <Fragment set:html={ARROW} /></a>
          <a class="btn" href="/courses/">Browse courses <Fragment set:html={ARROW} /></a>
        </div>
        <Socials />
      </div>
      <DiamondNav postCount={posts.length} />
    </div>
  </section>

  <div class="ribbon" aria-label="Popular topics">
    <div class="ribbon-in">
      <div class="ribbon-track">
        {ribbon.map((t, i) => <span style={`--c:var(--${BRAND_COLORS[i % 4]})`}><a href={`/tags/${slugifyStr(t)}/`}>{t}</a></span>)}
        <i class="dup" aria-hidden="true">
          {ribbon.map((t, i) => <span style={`--c:var(--${BRAND_COLORS[i % 4]})`}><a href={`/tags/${slugifyStr(t)}/`} tabindex="-1">{t}</a></span>)}
        </i>
      </div>
    </div>
  </div>

  <section class="band band--2">
    <div class="wrap">
      <div class="head rv">
        <div>
          <h2 class="h2 dot">Fresh off the keyboard</h2>
          <p class="sub muted">The latest posts on React, AI-assisted development and the tooling around them.</p>
        </div>
        <a class="btn btn--sm" href="/posts/">All {posts.length} posts <Fragment set:html={ARROW} /></a>
      </div>
      {latest && <div class="rv"><PostCard post={latest} featured /></div>}
      <div class="bento">
        {grid.map(p => <PostCard post={p} class="rv" />)}
      </div>
    </div>
  </section>

  <section class="band band--ink">
    <div class="wrap yrs">
      <div class="rv">
        <h2 class="h2">{years.length} years of writing it down<span style="color:var(--amber)">.</span></h2>
        <p class="sub" style="color:var(--on-ink-2)">
          From ASP.NET 2.0 membership providers in 2005 to MCP servers and Claude Code today. Pick a year to open the archive there.
        </p>
        <div class="stats">
          <div class="stat"><b data-count={posts.length}>{posts.length}</b><span>posts published</span></div>
          <div class="stat"><b data-count={topics.length}>{topics.length}</b><span>topics tagged</span></div>
          <div class="stat"><b data-count="19">19</b><span>Pluralsight courses</span></div>
          <div class="stat"><b data-count="12">12</b><span>years as an MVP</span></div>
        </div>
      </div>
      <YearChart years={years} />
    </div>
  </section>

  <section class="band band--red dots">
    <div class="wrap">
      <div class="head rv">
        <div>
          <h2 class="h2 dot">Learn React with me</h2>
          <p class="sub">Five of my nineteen Pluralsight courses, all on modern React.</p>
        </div>
        <div class="rail-ctl">
          <button class="icon-btn" type="button" data-rail="-1" aria-label="Previous courses">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><path d="M19 12H5M11 6l-6 6 6 6"></path></svg>
          </button>
          <button class="icon-btn" type="button" data-rail="1" aria-label="Next courses"><Fragment set:html={ARROW} /></button>
        </div>
      </div>
      <div class="rail" id="rail">
        {COURSES.map(c => <CourseCard course={c} />)}
      </div>
    </div>
  </section>

  <section class="band">
    <div class="wrap">
      <div class="head rv">
        <div>
          <h2 class="h2 dot">How I can help</h2>
          <p class="sub muted">One-on-one coaching for developers and teams working in JavaScript and React. Ask about special pricing for NGOs and non-profits.</p>
        </div>
        <a class="btn btn--green" href="/contact/">Get in touch <Fragment set:html={ARROW} /></a>
      </div>
      <Services />
    </div>
  </section>

  <section class="band band--amber dots">
    <div class="wrap">
      <div class="head rv">
        <div>
          <h2 class="h2 dot">Four decades of shipping</h2>
          <p class="sub">Building software and sharing what I learn along the way.</p>
        </div>
        <a class="btn" href="/about/">Full story <Fragment set:html={ARROW} /></a>
      </div>
      <Credentials />
    </div>
  </section>
</Layout>

<script>
  import { burst, reduceMotion } from "../scripts/fx";

  const reduce = reduceMotion();

  // Count the stats up from zero once.
  if (!reduce) {
    document.querySelectorAll<HTMLElement>("[data-count]").forEach(el => {
      const to = Number(el.dataset.count);
      let t0: number | null = null;
      const step = (ts: number) => {
        t0 ??= ts;
        const k = Math.min(1, (ts - t0) / 1400);
        el.textContent = String(Math.round(to * (1 - Math.pow(1 - k, 3))));
        if (k < 1) requestAnimationFrame(step);
      };
      requestAnimationFrame(step);
    });
  }

  // The diamond leans toward the pointer.
  const dia = document.getElementById("dia");
  if (dia && !reduce && matchMedia("(pointer: fine)").matches) {
    const stage = dia.parentElement!;
    stage.addEventListener("pointermove", e => {
      const r = stage.getBoundingClientRect();
      const x = (e.clientX - r.left) / r.width - 0.5;
      const y = (e.clientY - r.top) / r.height - 0.5;
      dia.style.transform = `rotateY(${x * 16}deg) rotateX(${-y * 16}deg)`;
    });
    stage.addEventListener("pointerleave", () => (dia.style.transform = ""));
  }

  // The PK tile spins the corners and throws confetti.
  document.querySelector(".dia-pk")?.addEventListener("click", e => {
    if (!dia) return;
    dia.classList.remove("spin");
    void dia.offsetWidth;
    dia.classList.add("spin");
    const ev = e as MouseEvent;
    burst(ev.clientX, ev.clientY, 20);
  });

  // Course rail arrows.
  document.querySelectorAll<HTMLElement>("[data-rail]").forEach(b =>
    b.addEventListener("click", () => {
      const rail = document.getElementById("rail");
      const card = rail?.firstElementChild as HTMLElement | null;
      if (!rail || !card) return;
      rail.scrollBy({ left: Number(b.dataset.rail) * (card.offsetWidth + 22), behavior: reduce ? "auto" : "smooth" });
    })
  );
</script>
