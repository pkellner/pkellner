---
export interface Props {
  currentPage: number;
  totalPages: number;
  prevUrl: string;
  nextUrl: string;
}

const { currentPage, totalPages, prevUrl, nextUrl } = Astro.props;
const prev = currentPage > 1;
const next = currentPage < totalPages;
---

{
  totalPages > 1 && (
    <nav class="pager" aria-label="Pagination">
      <a class="btn btn--sm" href={prev ? prevUrl : undefined} aria-disabled={!prev} rel="prev">← Newer</a>
      <span class="mono">Page {currentPage} of {totalPages}</span>
      <a class="btn btn--sm" href={next ? nextUrl : undefined} aria-disabled={!next} rel="next">Older →</a>
    </nav>
  )
}
