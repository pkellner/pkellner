---
import type { Course } from "../data/site";

export interface Props {
  course: Course;
}

const { course } = Astro.props;
---

<a class="card course" href={course.url} target="_blank" rel="noopener">
  <img src={course.image} alt="" width="640" height="400" loading="lazy" decoding="async" />
  <div class="course-b">
    <h3>{course.title}</h3>
    <p>{course.short}</p>
    <span class={`chip chip--${course.color}`}>Watch on Pluralsight</span>
  </div>
</a>
