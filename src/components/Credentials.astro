---
import { CREDENTIALS } from "../data/site";
---

<div class="creds">
  {
    CREDENTIALS.map(c => (
      <div class="card cred rv">
        <span class="yr" style={`--c:var(--${c.color});--oc:var(--on-${c.color})`}>{c.badge}</span>
        <div>
          <h3>{c.title}</h3>
          <p set:html={c.html} />
        </div>
      </div>
    ))
  }
</div>
