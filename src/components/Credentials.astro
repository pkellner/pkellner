---
import { CREDENTIALS } from "../data/site";

const ARROW = `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17 17 7M8 7h9v9" /></svg>`;
---

<div class="creds">
  {
    CREDENTIALS.map(c => {
      const badge = <span class="yr" style={`--c:var(--${c.color});--oc:var(--on-${c.color})`}>{c.badge}</span>;
      if (c.href && c.extras?.length) {
        // Several links: a div card whose main link covers it, with the extra links above.
        return (
          <div class="card cred cred--link cred--multi rv" style={`--c:var(--${c.color})`}>
            {badge}
            <div class="cred-b">
              <h3>{c.title}</h3>
              <p>{c.text}</p>
              <span class="cred-links">
                <a class="cred-go cred-main" href={c.href}>{c.site}<Fragment set:html={ARROW} /></a>
                {c.extras.map(x => <a class="cred-go cred-extra" href={x.href}>{x.label}<Fragment set:html={ARROW} /></a>)}
              </span>
            </div>
          </div>
        );
      }
      const body = (
        <>
          {badge}
          <div class="cred-b">
            <h3>{c.title}</h3>
            <p>{c.text}</p>
            {c.href && (
              <span class="cred-go">
                {c.site}
                <Fragment set:html={ARROW} />
              </span>
            )}
          </div>
        </>
      );
      return c.href ? (
        <a class="card cred cred--link rv" href={c.href} style={`--c:var(--${c.color})`}>
          {body}
        </a>
      ) : (
        <div class="card cred rv">{body}</div>
      );
    })
  }
</div>
