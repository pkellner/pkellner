---
import { CREDENTIALS } from "../data/site";
---

<div class="creds">
  {
    CREDENTIALS.map(c => {
      const body = (
        <>
          <span class="yr" style={`--c:var(--${c.color});--oc:var(--on-${c.color})`}>{c.badge}</span>
          <div class="cred-b">
            <h3>{c.title}</h3>
            <p>{c.text}</p>
            {c.href && (
              <span class="cred-go">
                {c.site}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M7 17 17 7M8 7h9v9" />
                </svg>
              </span>
            )}
          </div>
        </>
      );
      return c.href ? (
        <a class="card cred cred--link rv" href={c.href} style={`--c:var(--${c.color})`}>
          {body}
        </a>
      ) : (
        <div class="card cred rv">{body}</div>
      );
    })
  }
</div>
