---
export interface Props {
  activeNav?: string;
}

const { activeNav } = Astro.props;

const NAV = [
  { key: "posts", href: "/posts/", label: "Blog" },
  { key: "tags", href: "/tags/", label: "Tags" },
  { key: "courses", href: "/courses/", label: "Courses" },
  { key: "about", href: "/about/", label: "About" },
  { key: "contact", href: "/contact/", label: "Contact" },
];
const SHEET = [NAV[0], NAV[2], NAV[4], NAV[3], NAV[1], { key: "search", href: "/search/", label: "Search" }];
---

<header class="top">
  <div class="wrap top-in">
    <a class="logo" href="/" aria-label="PeterKellner.net home">
      <img src="/peterkellnerlogo.png" alt="PeterKellner.net" width="118" height="34" />
    </a>
    <nav class="nav" aria-label="Main">
      {NAV.map(n => <a href={n.href} aria-current={activeNav === n.key ? "page" : undefined}>{n.label}</a>)}
    </nav>
    <div class="tools">
      <button class="icon-btn search-btn" type="button" data-open-search aria-label="Search posts">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"><circle cx="11" cy="11" r="7"></circle><path d="m20 20-3.5-3.5"></path></svg>
        <span class="lbl">Search</span><kbd>⌘K</kbd>
      </button>
      <button class="icon-btn theme-btn" type="button" id="theme-btn" aria-label="Toggle dark mode">
        <svg class="moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linejoin="round"><path d="M20 14.5A8.5 8.5 0 0 1 9.5 4a8.5 8.5 0 1 0 10.5 10.5Z"></path></svg>
        <svg class="sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><rect x="8" y="8" width="8" height="8" rx="2" transform="rotate(45 12 12)"></rect><path d="M12 2v2M12 20v2M2 12h2M20 12h2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path></svg>
      </button>
      <button class="icon-btn menu-btn" type="button" id="menu-btn" aria-label="Open menu" aria-expanded="false" aria-controls="sheet">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"><path d="M4 7h16M4 12h16M4 17h10"></path></svg>
      </button>
    </div>
  </div>
  <div class="progress" id="progress"></div>
</header>
<nav class="sheet" id="sheet" aria-label="Mobile">
  {SHEET.map(n => <a href={n.href}>{n.label} <span aria-hidden="true">→</span></a>)}
</nav>

<style>
  .search-btn .lbl { font-weight: 700; font-size: 0.9rem; }
</style>
