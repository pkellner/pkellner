---
import Layout from "@layouts/Layout.astro";
import PageHead from "@components/PageHead.astro";
import PostRow from "@components/PostRow.astro";
import Pagination from "@components/Pagination.astro";
import { SITE } from "@config";
import type { PostView } from "@utils/collection";

export interface Props {
  currentPage: number;
  totalPages: number;
  paginatedPosts: PostView[];
}

const { currentPage, totalPages, paginatedPosts } = Astro.props;
---

<Layout title={`Posts, page ${currentPage} | ${SITE.title}`} activeNav="posts">
  <PageHead color="blue" crumbs={[{ label: "posts", href: "/posts/" }, { label: `page ${currentPage}` }]} title={`Page ${currentPage} of ${totalPages}`} noDot sub="Newest first. The full archive with year filters is one click away." deco={false}>
    <div class="cta" style="margin-top:22px"><a class="btn" href="/posts/">Open the full archive</a></div>
  </PageHead>
  <section class="band band--tight">
    <div class="wrap">
      <div class="rows">
        {paginatedPosts.map((p, i) => <PostRow post={p} i={i} />)}
      </div>
      <Pagination
        currentPage={currentPage}
        totalPages={totalPages}
        prevUrl={currentPage - 1 <= 1 ? "/posts/" : `/posts/${currentPage - 1}/`}
        nextUrl={`/posts/${currentPage + 1}/`}
      />
    </div>
  </section>
</Layout>
