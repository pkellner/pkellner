---
import { render, type CollectionEntry } from "astro:content";
import Layout from "@layouts/Layout.astro";
import Cover from "@components/Cover.astro";
import PostCard from "@components/PostCard.astro";
import ShareLinks from "@components/ShareLinks.astro";
import { SITE } from "@config";
import { getPosts, toView } from "@utils/collection";
import { formatDate, relatedPosts, summaryOf, tagPath } from "@utils/posts";
import { slugifyStr } from "@utils/slugify";

export interface Props {
  post: CollectionEntry<"blog">;
}

const { post } = Astro.props;
const { Content, headings } = await render(post);

const all = await getPosts();
const view = all.find(p => p.id === post.id) ?? toView(post);
const at = all.indexOf(view);
const newer = at > 0 ? all[at - 1] : undefined;
const older = at >= 0 && at < all.length - 1 ? all[at + 1] : undefined;
const related = relatedPosts(view, all, 3);
const toc = headings.filter(h => h.depth === 2);

const { description, canonicalURL, pubDatetime, modDatetime } = post.data;
const title = view.title;
const ogUrl = new URL(view.og ?? `/posts/${slugifyStr(post.data.title)}.png`, Astro.url.origin).href;
const liveUrl = new URL(view.url, SITE.website).href;
---

<Layout
  title={`${title} | ${SITE.title}`}
  author={post.data.author?.display_name ?? SITE.author}
  description={description ? summaryOf(post, 300) : view.summary}
  pubDatetime={pubDatetime}
  modDatetime={modDatetime}
  canonicalURL={canonicalURL}
  ogImage={ogUrl}
  activeNav="posts"
>
  <section class={`post-h band--${view.color} dots`}>
    <div class="wrap post-h-in">
      <div class="post-h-copy">
        <nav class="ph-crumb" aria-label="Breadcrumb">
          <a href="/">peterkellner.net</a><span aria-hidden="true">/</span>
          <a href={`/posts/#y${view.date.getUTCFullYear()}`}>{view.date.getUTCFullYear()}</a><span aria-hidden="true">/</span>
          <span>{String(view.date.getUTCMonth() + 1).padStart(2, "0")}/{String(view.date.getUTCDate()).padStart(2, "0")}</span>
        </nav>
        <h1 class:list={{ long: title.length > 58 }}>{title}</h1>
        <div class="meta">
          <time class="chip" datetime={view.date.toISOString()}>{formatDate(view.date)}</time>
          <span class="chip">{view.minutes} min read</span>
          {view.topics.slice(0, 5).map(t => <a class="chip chip--ink" href={tagPath(t)}>#{t}</a>)}
        </div>
      </div>
      <div class="post-cover" style="view-transition-name:pk-cover"><Cover post={view} eager /></div>
    </div>
  </section>

  <section class="band band--post">
    <div class="wrap post-b">
      <article class="pk-prose" id="prose">
        <Content />
      </article>
      <aside class="toc" aria-label="On this page">
        {
          toc.length > 1 && (
            <div class="card toc-box">
              <h4>On this page</h4>
              <ol id="toc-list">
                {toc.map(h => (
                  <li>
                    <a href={`#${h.slug}`}>{h.text}</a>
                  </li>
                ))}
              </ol>
            </div>
          )
        }
        <div class="card toc-box">
          <h4>Share</h4>
          <ShareLinks url={liveUrl} title={title} />
        </div>
      </aside>
    </div>
  </section>

  <section class="band band--2 band--tight">
    <div class="wrap">
      <div class="pn">
        {newer ? <a class="card" href={newer.url}><small>← Newer</small><b>{newer.title}</b></a> : <span />}
        {older ? <a class="card" href={older.url}><small>Older →</small><b>{older.title}</b></a> : <span />}
      </div>
      {
        related.length > 0 && (
          <>
            <div class="head" style="margin:56px 0 26px">
              <div>
                <h2 class="h2 dot">Keep reading</h2>
              </div>
              {view.topics[0] && (
                <a class="btn btn--sm" href={tagPath(view.topics[0])}>
                  More #{view.topics[0]} →
                </a>
              )}
            </div>
            <div class="grid3">
              {related.map(p => (
                <PostCard post={p} />
              ))}
            </div>
          </>
        )
      }
    </div>
  </section>
</Layout>

<script>
  // Highlight the section being read in the table of contents.
  const list = document.getElementById("toc-list");
  if (list) {
    const links = [...list.querySelectorAll<HTMLAnchorElement>("a")];
    const heads = links
      .map(a => document.getElementById(decodeURIComponent(a.hash.slice(1))))
      .filter((h): h is HTMLElement => !!h);
    const io = new IntersectionObserver(
      entries =>
        entries.forEach(en => {
          if (en.isIntersecting) links.forEach(l => l.classList.toggle("on", l.hash === `#${en.target.id}`));
        }),
      { rootMargin: "-90px 0px -65% 0px" }
    );
    heads.forEach(h => io.observe(h));
  }
</script>
