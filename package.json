{
  "name": "pkellner-blog-astropaper",
  "version": "4.4.0",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "prebuild": "node scripts/convert-og-svgs.mjs",
    "build": "astro check && astro build",
    "buildclear": "node -e \"for (const d of ['dist', 'public/og-cache']) require('fs').rmSync(d, { recursive: true, force: true })\" && astro check && astro build",
    "preview": "astro preview",
    "sync": "astro sync",
    "astro": "astro",
    "lint": "eslint .",
    "test": "vitest run",
    "test:dist": "node scripts/check-dist.mjs",
    "verify": "npm run lint && npm test && npm run build && npm run test:dist"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/markdown-remark": "^7.3.2",
    "@astrojs/rss": "^4.0.19",
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.3.8",
    "github-slugger": "^2.0.0",
    "rehype-external-links": "^3.0.0",
    "satori": "^0.44.0",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3"
  },
  "devDependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.71.1",
    "@typescript-eslint/parser": "^8.71.1",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "prettier-plugin-astro": "^1.1.0",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "react": "^19.3.0",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "overrides": {
    "fflate": "0.7.5"
  }
}
